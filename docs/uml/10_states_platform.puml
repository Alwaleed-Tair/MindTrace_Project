@startuml
!include _style.iuml
title Platform State Machines

state "Experiment.status" as ES {
  [*] --> Active : create / new recording
  [*] --> Paused : new recording said\n"paused_will_resume"
  [*] --> Completed : new recording said\n"completed"
  Active --> Paused : PATCH status /\nrecording "paused_will_resume"
  Paused --> Active : PATCH status /\nrecording "ongoing"
  Active --> Completed : PATCH status /\nrecording "completed"
  Paused --> Completed : PATCH status /\nrecording "completed"
  Completed --> Active : PATCH status /\nrecording "ongoing"
}
note right of ES : any member may change it;\nthe others get status_changed

state "Experiment.ai_status" as AS {
  [*] --> none
  none --> disabled : no DEEPSEEK_API_KEY
  none --> queued : upload (auto) / POST insights
  queued --> running : insights.run()
  running --> done : analyze + literature OK
  running --> failed : AiError / no notes /\nunexpected error
  done --> queued : Refresh insights
  failed --> queued : retry
  done --> done : translate (cached per language)
}
@enduml
