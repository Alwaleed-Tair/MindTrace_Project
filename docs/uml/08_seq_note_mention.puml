@startuml
!include _style.iuml
title Sequence - adding a note with an @mention
autonumber
actor "Owner" as O
participant "AddNoteCard +\nMentionTextarea" as UI
participant "react-query" as Q
participant "FastAPI" as API
participant "services.experiments" as EX
participant "services.mentions" as M
database SQLite as DB
actor "Mentioned member" as B
actor "Other members" as X

UI -> API : GET /api/experiments/{id}/members
API -> M : member_list()  (owner, collaborators, team)
API --> UI : [{id: MT-..., name, initials, role}]
O -> UI : types "check this @Ba"
UI -> UI : activeQuery() -> filtered list
O -> UI : Enter -> inserts "@Badr "
O -> UI : Save
UI -> UI : toStored(): "@Badr" -> "@{MT-XXXXXXXX}"
UI -> Q : useAddNote.mutate(text)
Q -> API : POST /api/experiments/{id}/notes\ncookie + X-Requested-With
API -> EX : add_note()
EX -> EX : require() member? clean text (<= 5000)
EX -> DB : INSERT notes
EX -> M : mentioned(exp, text)  (members only)
EX -> DB : notification kind=mentioned -> B
EX -> DB : notification kind=note_added -> X\n(skip author and B)
API --> Q : note {..., mentions:[{id,name}]}
Q -> UI : refetch experiment -> NoteText shows chip "@Badr"
B -> API : GET /api/notifications (polling)
API --> B : "Owner mentioned you in a note in ..."
@enduml
