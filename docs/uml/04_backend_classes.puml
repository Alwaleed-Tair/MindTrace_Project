@startuml
!include _style.iuml
title MindTrace platform backend - Package / Class Diagram (FastAPI)
skinparam packageStyle rectangle
hide empty members

package "api (routers)" {
  class auth <<router /api/auth>> {
    POST register, login, logout
    GET/PATCH/DELETE me
    POST api-token, password, forgot, reset
  }
  class experiments_api <<router /api>> {
    GET/POST /experiments
    GET/PATCH/DELETE /experiments/{id}
    GET /experiments/{id}/members
    POST /experiments/{id}/notes
    PATCH/DELETE /notes/{id}
    GET .../notes/{id}/audio
    POST/DELETE .../collaborators
    GET/POST .../insights, POST .../insights/translate
  }
  class sessions_api <<router /api/sessions>> {
    POST "" (session.json + WAVs)
    GET "", GET /{id}, GET /{id}/audio/{name}
  }
  class bridge_api <<router /api/bridge>> {
    POST heartbeat (token only)
    GET status
  }
  class teams_api <<router /api>> {
    /teams CRUD, members, roles
    POST /teams/{id}/invite
    GET/POST /invites/{token}[/accept]
  }
  class misc_api <<router /api>> {
    GET /users/search, /collaborators/recent
    GET /notifications, POST /notifications/read
    GET /stats
  }
  class deps {
    current_user(request) : cookie | Bearer mt_
    CSRF: X-Requested-With on writes
  }
}

package services {
  class users {
    create_user() authenticate()
    start_session() user_for_session()
    create_api_token() user_for_api_token()
    create_reset_token() reset_password()
    public(row) initials(name)
  }
  class experiments {
    role_of() require()
    create/update/delete_experiment()
    add_note() update_note() delete_note()
    add/remove_collaborator()
    notify_members() _notify_mentions()
    list_notifications() mark_read() stats()
    serialize() serialize_note()
  }
  class mentions {
    TOKEN_RE = @\{MT-XXXXXXXX\}
    members(exp) member_list(exp)
    mentioned(exp, text)
    render_plain(text)
  }
  class sessions {
    upsert(raw, SessionIn, audio_files)
    experiment_title(title)
    find_by_title() _sync_notes()
  }
  class insights {
    build_input() run() translate() get()
    _literature()
  }
  class ai {
    analyze() make_queries()
    assess_originality() translate_texts()
    parse_result() _chat_json()
  }
  class literature {
    search(queries)
    _openalex _semanticscholar _arxiv _crossref
  }
  class teams {
    create/rename/delete_team()
    add_member() set_role() remove_member()
    reset_invite() accept_invite()
  }
  class storage {
    save_audio() list_audio() audio_path()
    ALLOWED_AUDIO whitelist
  }
  class mailer
}

package core {
  class Database {
    tx() one() all() run()
    SCHEMA + MIGRATIONS
  }
  class Settings {
    data_dir, cors_origins, cookie_secure
    max_upload_mb, ai_*, smtp_*
  }
}
package schemas {
  class SessionIn <<pydantic>>
}

auth --> users
experiments_api --> experiments
experiments_api --> mentions
experiments_api --> insights
experiments_api --> storage
sessions_api --> sessions
sessions_api --> storage
sessions_api --> insights
sessions_api ..> SessionIn
bridge_api --> Database
teams_api --> teams
misc_api --> users
misc_api --> experiments
experiments --> mentions
experiments --> users
mentions --> users
sessions --> experiments
insights --> ai
insights --> literature
insights --> mentions
auth --> mailer
users --> Database
experiments --> Database
sessions --> Database
teams --> Database
insights --> Database
ai ..> Settings
@enduml
