# Copy to .env (git-ignored). Never commit the real keys.

# --- backend ---
MINDTRACE_DATA_DIR=./data                  # SQLite + audio live here (docker: /data)
MINDTRACE_API_KEY=                         # empty = no auth (fine on localhost). Set it on any shared server; the bridge uses the same value.
MINDTRACE_CORS_ORIGINS=http://localhost:3000   # where the web UI runs (comma separated)
MINDTRACE_MAX_UPLOAD_MB=300

# --- DeepSeek review (optional; without a key the platform works, ai.status = disabled) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
MINDTRACE_AI_AUTO=true                     # analyse each session right after it arrives
MINDTRACE_AI_TIMEOUT_SEC=90
MINDTRACE_AI_LANGUAGE=Arabic               # language of the summary / gaps

# --- bridge (laptop) ---
MINDTRACE_PLATFORM_URL=http://localhost:8000
MINDTRACE_SESSIONS_DIR=../MindTrace2/sessions
