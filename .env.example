# Copy to backend/.env (or .env at the repository root) and fill in. These files are git-ignored: never commit real keys.

# --- DeepSeek (optional; without a key everything works except the AI insights) ---
DEEPSEEK_API_KEY=

# --- backend (all optional, shown with their defaults) ---
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-chat
# MINDTRACE_DATA_DIR=./data                    # SQLite database + audio files
# MINDTRACE_ENV=development                    # "production" refuses to seed demo accounts
# MINDTRACE_COOKIE_SECURE=false                # set true when served over https
# MINDTRACE_SESSION_DAYS=30
# MINDTRACE_DEMO_ENABLED=true                  # the "Open demo workspace" button
# MINDTRACE_DEV_TOOLS=false                    # true = mock-collaborator endpoint for testing notifications
# MINDTRACE_CORS_ORIGINS=http://localhost:3000 # only needed if the UI is served from another origin
# MINDTRACE_AI_AUTO=true                       # analyse each recorded session as it arrives
# MINDTRACE_AI_LANGUAGE=Arabic                 # default language of the AI texts (the web app asks for its own language)
# MINDTRACE_LITERATURE=true                    # originality: compare with scholarly papers (OpenAlex, Semantic Scholar, arXiv, Crossref)
# OPENALEX_API_KEY=                            # optional free key (openalex.org) if the shared quota is used up
# SEMANTIC_SCHOLAR_API_KEY=                    # optional free key
# MINDTRACE_CONTACT_EMAIL=                     # optional: sent in the User-Agent, scholarly APIs prefer it
# MINDTRACE_MAX_UPLOAD_MB=300
# MINDTRACE_DEMO_PASSWORD=                     # password of the seeded demo users (default is in backend/seed.py)

# --- password reset e-mails (optional; without SMTP the reset link is written to the server log,
#     and `python manage.py reset-link EMAIL` prints one) ---
# MINDTRACE_PUBLIC_URL=https://mindtrace.example.org   # the address people open (used in the e-mailed link)
# MINDTRACE_SMTP_HOST=smtp.gmail.com
# MINDTRACE_SMTP_PORT=587                      # 587 = STARTTLS, 465 = SSL
# MINDTRACE_SMTP_USER=
# MINDTRACE_SMTP_PASSWORD=                     # e.g. a Gmail app password
# MINDTRACE_SMTP_FROM=MindTrace <no-reply@example.org>
# MINDTRACE_RESET_MINUTES=60

# --- bridge (on the laptop; the token is created in the web app, Settings) ---
# MINDTRACE_API_TOKEN=
# MINDTRACE_PLATFORM_URL=http://localhost:8000
# MINDTRACE_SESSIONS_DIR=../MindTrace/MindTrace2/sessions
